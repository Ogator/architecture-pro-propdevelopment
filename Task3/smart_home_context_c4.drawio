        <object placeholders="1" c4Name="PropDevelopment" c4Type="Software System" c4Description="Мобильное приложение собственников и бэкенд ЖКУ. Новое: управление правами доступа и интеграция с платформой «Умный дом»" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="pd"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="300" y="430" width="960" height="160" as="geometry" /></mxCell></object>
