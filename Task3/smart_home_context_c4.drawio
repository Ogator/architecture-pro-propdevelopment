        <mxCell id="t0" value='&lt;b style="font-size:20px"&gt;Диаграмма контекста (C4, уровень 1): сервисы «Умный дом» — интеллектуальный домофон и шлагбаум&lt;/b&gt;' style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="-150" width="1600" height="40" as="geometry" /></mxCell>
